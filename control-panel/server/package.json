{
  "name": "echoscript-control-panel-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ECHOSCRIPT_DEV=1 bun --env-file=server.env --watch run server.ts",
    "start": "bun --env-file=server.env run server.ts",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "typescript": "~5.7.0"
  }
}
