{
  "jobs_root": "./jobs",
  "max_workers": 1,
  "poll_interval_ms": 500,
  "stream_window_ms": 30000,
  "stream_rollover_ms": 1200000,
  "daemon_registry_ttl_ms": 15000,
  "drop_stable_ms": 2000,
  "max_requeue_attempts": 5,
  "default_model": "whisper_podlodka",
  "ffmpeg_path": "./tools/ffmpeg/ffmpeg.exe",
  "ws_daemons": {
    "whisperdaemon": { "host": "127.0.0.1", "port": 7801, "model_name": "whisper_podlodka" }
  },
  "speech": {
    "command_grammars": {
      "ru": [
        "вверх",
        "вниз",
        "дальше",
        "назад",
        "пауза",
        "старт",
        "стоп"
      ]
    }
  },
  "models": {
    "whisper_podlodka": {
      "service_dir": "./services/whisper_podlodka",
      "python_executable": "./services/whisper_podlodka/venv/bin/python",
      "module": "app.main"
    },
    "borealis": {
      "service_dir": "./services/borealis",
      "python_executable": "./services/borealis/venv/bin/python",
      "module": "app.main"
    },
    "gemma4": {
      "service_dir": "./services/gemma4",
      "python_executable": "./services/gemma4/venv/bin/python",
      "module": "app.main"
    },
    "vibevoice": {
      "service_dir": "./services/vibevoice",
      "python_executable": "./services/vibevoice/venv/bin/python",
      "module": "app.main"
    },
    "vosk_ru": {
      "service_dir": "./services/vosk_ru",
      "python_executable": "./services/vosk_ru/venv/bin/python",
      "module": "app.main"
    },
    "vosk_ru_cmd": {
      "service_dir": "./services/vosk_ru_cmd",
      "python_executable": "./services/vosk_ru_cmd/venv/bin/python",
      "module": "app.main"
    },
    "vosk_en": {
      "service_dir": "./services/vosk_en",
      "python_executable": "./services/vosk_en/venv/bin/python",
      "module": "app.main"
    }
  }
}
